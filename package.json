{
  "name": "plateforme-sensibilisation-ssi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Plateforme générique et accessible de sensibilisation et de formation à la sécurité du SI",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
