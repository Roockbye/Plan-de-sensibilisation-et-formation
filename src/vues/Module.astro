---
/** Page d'un module : pré-test → essentiel → mise en situation → post-test. Versions standard et FALC. */
import Base from '../layouts/Base.astro';
import Markdown from '../components/Markdown.astro';
import Quiz from '../components/Quiz.astro';
import Scenario from '../components/Scenario.astro';
import BoiteMail from '../components/BoiteMail.astro';
import Media from '../components/Media.astro';
import { donnees } from '../lib/donnees.ts';
import type { Cle } from '../i18n/index.ts';
import type { Langue, Texte } from '../lib/texte.ts';

interface Props { langue: Langue; id: string; falc: boolean }
const { id, falc } = Astro.props;
const d = donnees(Astro.props.langue);
const { T } = d;
const lang = (v: Texte) => (d.langueDe(v) !== d.langue ? 'fr' : undefined);
const m = d.module(id);
const meta = m.meta;
const titre = `${meta.code} – ${d.tr(meta.titre)}`;
const base = d.lien(`/modules/${meta.id}/`);
const lienFalc = `${base}facile/`;

// Contenus dans la langue de la page, ou repli sur le français (signalé et balisé lang="fr").
const corps = d.contenu(falc ? m.falc : m.standard);
const quiz = d.contenu(m.quiz);
const scenario = m.scenario ? d.contenu(m.scenario) : undefined;
const transcriptions = Object.fromEntries(Object.entries(m.transcriptions).map(([k, v]) => [k, d.contenu(v).valeur]));
const langCorps = corps.langue !== d.langue ? corps.langue : undefined;

const index = d.modules.findIndex((x) => x.meta.id === id);
const precedent = d.modules[index - 1]?.meta;
const suivant = d.modules[index + 1]?.meta;

const mediasScenario = new Set(scenario?.valeur.type === 'embranchements' ? scenario.valeur.etapes.flatMap((e) => (e.media ? [e.media] : [])) : []);
const mediasLibres = meta.medias.filter((x) => !mediasScenario.has(x.id));
const lien = (autre: typeof meta) => d.lien(`/modules/${autre.id}/${falc ? 'facile/' : ''}`);
const numeroPosttest = scenario ? 4 : 3;
---
<Base
  titre={falc ? `${titre} (${T('module.versionFalc')})` : titre}
  langue={d.langue}
  description={d.tr(meta.resume)}
  filAriane={[{ libelle: T('nav.modules'), href: d.lien('/modules/') }, falc ? { libelle: meta.code, href: base } : { libelle: meta.code }, ...(falc ? [{ libelle: T('module.falcCourt') }] : [])]}
>
  <article class="module lecture" data-page-module={meta.id}>
    <h1>{meta.code} – <span lang={lang(meta.titre)}>{d.tr(meta.titre)}</span></h1>

    {langCorps && <p class="encart encart--attention">{T('module.nonTraduit')}</p>}

    {falc ? (
      <p class="encart">
        <strong>{T('module.versionFalc')}.</strong> <a href={base}>{T('module.lienStandard')}</a>
      </p>
    ) : (
      <>
        <p class="encart suggestion-falc">
          {T('module.suggestionFalc')} <a href={lienFalc}>{T('module.lienFalc')}</a>
        </p>
        <p><a class="lien-falc" href={lienFalc}>{T('module.lienFalc')}</a></p>
      </>
    )}

    <p class="module__resume" lang={lang(meta.resume)}>{d.tr(meta.resume)}</p>

    <dl class="meta">
      <dt>{T('commun.duree')}</dt>
      <dd>{T('commun.minutes', { n: meta.dureeMinutes })}</dd>
      <dt>{T('commun.niveau')}</dt>
      <dd>{T(`niveau.${meta.niveau}` as Cle)}</dd>
      <dt>{T('commun.formats')}</dt>
      <dd>{meta.formats.map((f) => T(`format.${f}` as Cle)).join(', ')}</dd>
      <dt>{T('commun.risques')}</dt>
      <dd>
        <ul class="etiquettes">
          {meta.risques.map((r) => (
            <li>
              {d.libelleRisque(r)}
              {d.risque(r)?.emergent && <span class="etiquette etiquette--emergent">{T('commun.emergent')}</span>}
            </li>
          ))}
        </ul>
      </dd>
      <dt>{T('commun.profils')}</dt>
      <dd>{meta.profils.filter((p) => d.config.profilsActifs.includes(p)).map((p) => d.libelleProfil(p)).join(', ')}</dd>
      <dt>{T('commun.statut')}</dt>
      <dd><span class="statut" data-statut-module={meta.id}>{T('statut.aFaire')}</span></dd>
    </dl>

    <h2>{T('commun.objectifs')}</h2>
    <ul>
      {meta.objectifs.map((o) => <li lang={lang(o)}>{d.tr(o)}</li>)}
    </ul>

    <nav class="module__etapes" aria-labelledby="titre-etapes">
      <h2 id="titre-etapes">{T('module.etapes')}</h2>
      <ol>
        <li><a href="#pretest">{T('module.etape1')}</a></li>
        <li><a href="#essentiel">{T('module.etape2')}</a></li>
        {scenario && <li><a href="#situation">{T('module.etape3')}</a></li>}
        <li><a href="#posttest">{T('module.etape4')}</a></li>
      </ol>
    </nav>

    <section id="pretest" aria-labelledby="titre-pretest">
      <h2 id="titre-pretest">1. {T('module.etape1')}</h2>
      <p>{T('module.pretestIntro')}</p>
      <Quiz module={meta.id} phase="pretest" questions={quiz.valeur.pretest} falc={falc} langue={d.langue} langueContenu={quiz.langue} />
    </section>

    <section id="essentiel" aria-labelledby="titre-essentiel">
      <h2 id="titre-essentiel">2. {T('module.etape2')}</h2>
      <div lang={langCorps}>
        <Markdown source={corps.valeur} decalageTitres={1} />
      </div>
      {mediasLibres.map((x) => <Media media={x} transcription={transcriptions[x.id]} langue={d.langue} langueContenu={corps.langue} />)}
    </section>

    {scenario && (
      <section id="situation" aria-labelledby="titre-situation">
        <h2 id="titre-situation">3. {T('module.etape3')} : <span lang={scenario.langue !== d.langue ? scenario.langue : undefined}>{d.tr(scenario.valeur.titre)}</span></h2>
        {scenario.valeur.type === 'boite-mail' ? (
          <BoiteMail module={meta} scenario={scenario.valeur} langue={d.langue} langueContenu={scenario.langue} />
        ) : (
          <Scenario module={meta} scenario={scenario.valeur} transcriptions={transcriptions} langue={d.langue} langueContenu={scenario.langue} />
        )}
      </section>
    )}

    <section id="posttest" aria-labelledby="titre-posttest">
      <h2 id="titre-posttest">{numeroPosttest}. {T('module.etape4')}</h2>
      <p>{T('module.posttestIntro', { seuil: d.config.evaluation.seuilReussite })}</p>
      <Quiz module={meta.id} phase="posttest" questions={quiz.valeur.posttest} falc={falc} langue={d.langue} langueContenu={quiz.langue} />
    </section>

    {meta.sources.length > 0 && (
      <section aria-labelledby="titre-sources">
        <h2 id="titre-sources">{T('commun.sources')}</h2>
        <ul>
          {meta.sources.map((s) => (
            <li><a href={s.url} rel="noopener noreferrer" lang="fr">{s.titre}<span class="visuellement-masque" lang={d.langue}> ({T('commun.siteExterne')})</span></a></li>
          ))}
        </ul>
      </section>
    )}

    <p class="module__version">{T('module.version', { version: meta.version, date: d.date(meta.derniereRevue), frequence: d.frequence(meta.renouvellement).toLowerCase() })}</p>

    <nav class="module__navigation" aria-label={T('module.navigation')}>
      <ul>
        {precedent && <li><a href={lien(precedent)} rel="prev">{T('module.precedent')} : {precedent.code} – <span lang={lang(precedent.titre)}>{d.tr(precedent.titre)}</span></a></li>}
        {suivant && <li><a href={lien(suivant)} rel="next">{T('module.suivant')} : {suivant.code} – <span lang={lang(suivant.titre)}>{d.tr(suivant.titre)}</span></a></li>}
      </ul>
    </nav>
  </article>
</Base>

<script>
  import '../scripts/statuts.ts';
</script>
