---
/** Catalogue : chaque module est une carte ATTAQUE (menace principale) du jeu. */
import Base from '../layouts/Base.astro';
import CarteJeu from '../components/CarteJeu.astro';
import { donnees } from '../lib/donnees.ts';
import type { Cle } from '../i18n/index.ts';
import { sansCoupure, type Langue, type Texte } from '../lib/texte.ts';

interface Props { langue: Langue }
const d = donnees(Astro.props.langue);
const { T } = d;
const lang = (v: Texte) => (d.langueDe(v) !== d.langue ? 'fr' : undefined);
---
<Base titre={T('nav.modules')} langue={d.langue} filAriane={[{ libelle: T('nav.modules') }]}>
  <h1>{T('nav.modules')}</h1>
  <p class="lecture">{T('modules.intro', { n: d.modules.length })}</p>

  <ul class="catalogue">
    {d.modules.map(({ meta }) => {
      const emergent = meta.risques.some((r) => d.risque(r)?.emergent);
      const nonTraduit = d.langue !== 'fr' && d.contenu(d.module(meta.id).standard).langue !== d.langue;
      return (
        <li>
          <CarteJeu
            famille="attaque"
            libelle={`${T('module.attaqueLibelle')} · ${d.libelleRisque(meta.risques[0])}`}
            titre={sansCoupure(`${meta.code} – ${d.tr(meta.titre)}`)}
            langTitre={lang(meta.titre)}
            niveauTitre="h2"
            lien={d.lien(`/modules/${meta.id}/`)}
            attributsLien={{ 'data-lien-module': meta.id }}
          >
            <p class="carte-jeu__texte" lang={lang(meta.resume)}>{d.tr(meta.resume)}</p>
            <p class="catalogue__infos">
              <span>{T('commun.minutes', { n: meta.dureeMinutes })}</span>
              <span>{T(`niveau.${meta.niveau}` as Cle)}</span>
              <span>{T('catalogue.parades', { n: meta.parades.length })}</span>
              {emergent && <span class="etiquette etiquette--emergent">{T('commun.emergent')}</span>}
            </p>
            {nonTraduit && <p class="catalogue__note">{T('module.nonTraduitCourt')}</p>}
            <p class="carte-jeu__pied catalogue__pied">
              <span>{T('commun.statut')} : <span class="statut" data-statut-module={meta.id}>{T('statut.aFaire')}</span></span>
              <a href={d.lien(`/modules/${meta.id}/facile/`)}>{T('module.versionFacileCourt')}<span class="visuellement-masque"> : {meta.code}</span></a>
            </p>
          </CarteJeu>
        </li>
      );
    })}
  </ul>
</Base>

<script>
  import '../scripts/statuts.ts';
</script>
