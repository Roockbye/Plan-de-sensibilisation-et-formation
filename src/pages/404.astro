---
import Base from '../layouts/Base.astro';
import { donnees } from '../lib/donnees.ts';

const d = donnees();
const { T } = d;
---
<Base titre={T('page404.titre')} langue={d.langue}>
  <div class="lecture">
    <h1>{T('page404.titre')}</h1>
    <p>{T('page404.texte')}</p>
    <ul>
      <li><a href={d.lien('/')}>{T('page404.accueil')}</a></li>
      <li><a href={d.lien('/plan-du-site/')}>{T('page404.planDuSite')}</a></li>
    </ul>
  </div>
</Base>
