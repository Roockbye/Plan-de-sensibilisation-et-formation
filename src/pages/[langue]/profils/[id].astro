---
import Vue from '../../../vues/Profil.astro';
import { languesPubliees } from '../../../lib/donnees.ts';
import { plateforme } from '../../../lib/contenus.ts';
import type { Langue } from '../../../lib/texte.ts';

export function getStaticPaths() {
  return languesPubliees().autres.flatMap((langue) => plateforme().profils.map((p) => p.id).map((id) => ({ params: { langue, id } })));
}
---
<Vue langue={Astro.params.langue as Langue} id={Astro.params.id!} />
