---
import Base from '../../layouts/Base.astro';
import { donnees, LIBELLES_PRIORITE } from '../../lib/donnees.ts';
import { plateforme } from '../../lib/contenus.ts';
import { traducteur, type Cle } from '../../i18n/index.ts';

export function getStaticPaths() {
  return plateforme().profils.map((p) => ({ params: { id: p.id } }));
}

const d = donnees();
const T = traducteur(d.langue);
const parcours = d.parcours.find((p) => p.profil.id === Astro.params.id)!;
const profil = parcours.profil;
const libelle = d.tr(profil.libelle);
const categories = ['obligatoire', 'prioritaire', 'complementaire'] as const;
const titresCategories = {
  obligatoire: 'Socle obligatoire',
  prioritaire: 'Modules prioritaires (selon l\'analyse de risques)',
  complementaire: 'Modules complémentaires',
};
---
<Base titre={`Parcours ${libelle}`} filAriane={[{ libelle: T('nav.profils'), href: '/profils/' }, { libelle }]}>
  <h1>Parcours : {libelle}</h1>
  <div class="lecture">
    <p>{d.tr(profil.description)}</p>
    <p class="groupe-boutons">
      <button type="button" data-choisir-profil={profil.id}>C'est mon profil</button>
      <span data-profil-confirmation role="status"></span>
    </p>

    <h2>Besoins identifiés</h2>
    <ul>{profil.besoins.map((b) => <li>{d.tr(b)}</li>)}</ul>

    {profil.contraintes.length > 0 && (
      <>
        <h2>Contraintes prises en compte</h2>
        <ul>{profil.contraintes.map((c) => <li>{d.tr(c)}</li>)}</ul>
      </>
    )}

    <h2>Objectifs pédagogiques</h2>
    <p>À l'issue du parcours, la personne est capable de :</p>
    <div class="tableau-defilant" tabindex="0" role="region" aria-labelledby="legende-objectifs">
      <table>
        <caption id="legende-objectifs">Objectifs, niveau visé et modules qui les travaillent et les évaluent</caption>
        <thead>
          <tr><th scope="col">Objectif</th><th scope="col">Niveau visé</th><th scope="col">Modules</th></tr>
        </thead>
        <tbody>
          {profil.objectifs.map((o) => (
            <tr>
              <th scope="row">{d.tr(o.texte)}</th>
              <td>{T(`bloom.${o.niveau}` as Cle)}</td>
              <td>{o.modules.map((m, i) => <>{i > 0 && ', '}<a href={`/modules/${m}/`} data-lien-module={m}>{d.module(m).meta.code}</a></>)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2>Risques auxquels ce profil est particulièrement exposé</h2>
    <ul>
      {profil.exposition.map((r) => (
        <li>
          {d.libelleRisque(r)}
          {d.prioriteRisque(r) ? ` – ${LIBELLES_PRIORITE[d.prioriteRisque(r)!]} pour l'organisation` : ' – non prioritaire dans l\'analyse de risques actuelle'}
        </li>
      ))}
    </ul>
  </div>

  <h2>Parcours proposé ({parcours.etapes.length} modules, {parcours.dureeTotaleMinutes} minutes)</h2>
  <p class="lecture">
    L'ordre est calculé automatiquement : le socle obligatoire d'abord, puis les modules couvrant les risques
    prioritaires de l'organisation (le poids d'un risque est doublé lorsque ce profil y est particulièrement exposé).
  </p>

  {categories.map((cat) => {
    const etapes = parcours.etapes.filter((e) => e.categorie === cat);
    return etapes.length > 0 && (
      <section aria-labelledby={`cat-${cat}`}>
        <h3 id={`cat-${cat}`}>{titresCategories[cat]}</h3>
        <ol class="parcours">
          {etapes.map((e) => (
            <li class="carte parcours__etape">
              <h4><a href={`/modules/${e.module.id}/`} data-lien-module={e.module.id}>{e.module.code} – {d.tr(e.module.titre)}</a></h4>
              <p>{d.tr(e.module.resume)}</p>
              <p>
                {T('commun.minutes', { n: e.module.dureeMinutes })} – {T(`niveau.${e.module.niveau}` as Cle)} –
                Statut : <span class="statut" data-statut-module={e.module.id}>{T('statut.aFaire')}</span>
              </p>
              {e.raisons.length > 0 && (
                <details>
                  <summary>{T('module.pourquoi')}<span class="visuellement-masque"> ({e.module.code})</span></summary>
                  <ul>
                    {e.raisons.map((r) => (
                      <li>
                        {d.libelleRisque(r.risque)} : {LIBELLES_PRIORITE[r.priorite].toLowerCase()}
                        {r.exposition ? ', profil particulièrement exposé (poids doublé)' : ''} → {r.points} point{r.points > 1 ? 's' : ''}
                      </li>
                    ))}
                  </ul>
                  <p>Score de priorité : {e.score}.</p>
                </details>
              )}
            </li>
          ))}
        </ol>
      </section>
    );
  })}

  {parcours.risquesNonCouverts.length > 0 && (
    <p class="encart encart--attention lecture">
      Risques prioritaires de l'organisation non traités dans ce parcours :
      {parcours.risquesNonCouverts.map((r) => d.libelleRisque(r)).join(', ')}.
      Ils sont couverts par les parcours d'autres profils ou par des mesures techniques.
    </p>
  )}
</Base>

<script>
  import '../../scripts/statuts.ts';
  import { lireProgression, ecrireProgression } from '../../scripts/stockage.ts';

  const bouton = document.querySelector<HTMLButtonElement>('[data-choisir-profil]');
  const confirmation = document.querySelector<HTMLElement>('[data-profil-confirmation]');
  if (bouton && confirmation) {
    const id = bouton.dataset.choisirProfil!;
    const majEtat = () => {
      const actif = lireProgression().profil === id;
      bouton.setAttribute('aria-pressed', String(actif));
      if (actif) confirmation.textContent = 'Ce profil est enregistré comme le vôtre.';
    };
    majEtat();
    bouton.addEventListener('click', () => {
      const p = lireProgression();
      p.profil = id;
      if (!ecrireProgression(p)) confirmation.textContent = 'Impossible d\'enregistrer : le stockage local est indisponible.';
      majEtat();
    });
  }
</script>
