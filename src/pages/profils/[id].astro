---
import Vue from '../../vues/Profil.astro';
import { languesPubliees } from '../../lib/donnees.ts';
import { plateforme } from '../../lib/contenus.ts';

export function getStaticPaths() {
  return plateforme().profils.map((p) => p.id).map((id) => ({ params: { id } }));
}
---
<Vue langue={languesPubliees().defaut} id={Astro.params.id!} />
