---
import Base from '../layouts/Base.astro';
import GraphiqueBarres from '../components/GraphiqueBarres.astro';
import { donnees, formaterDate } from '../lib/donnees.ts';
import { LIBELLES_TYPE } from '../lib/calendrier.ts';
import { traducteur } from '../i18n/index.ts';

const d = donnees();
const T = traducteur(d.langue);
const tdb = d.tableauDeBord();
const libelles = tdb.parProfil.map((p) => d.libelleProfil(p.profil));
const seuil = d.config.evaluation.seuilReussite;
const numero = (id: string) => id.replace('simulation-', 'Simulation n° ');
---
<Base titre={T('nav.tableauDeBord')} filAriane={[{ libelle: T('nav.tableauDeBord') }]}>
  <h1>Tableau de bord du RSSI</h1>
  <p class="encart encart--attention lecture">
    <strong>Données fictives.</strong> Population de {tdb.effectifTotal} personnes générée automatiquement à partir de
    l'effectif et des profils de la configuration, à la date du {formaterDate(tdb.dateReference)}. Aucun résultat réel n'est collecté.
  </p>

  <h2>Indicateurs clés</h2>
  <ul class="indicateurs">
    <li class="carte indicateur">
      <p class="indicateur__valeur">{tdb.global.tauxCompletion} %</p>
      <p class="indicateur__libelle">des modules assignés sont terminés</p>
    </li>
    <li class="carte indicateur">
      <p class="indicateur__valeur">{tdb.global.scorePreMoyen} % → {tdb.global.scorePostMoyen} %</p>
      <p class="indicateur__libelle">score moyen avant (pré-test) et après (post-test) les modules</p>
    </li>
    <li class="carte indicateur">
      <p class="indicateur__valeur">{tdb.global.tauxReussite} %</p>
      <p class="indicateur__libelle">des post-tests atteignent le seuil de {seuil} %</p>
    </li>
    <li class="carte indicateur">
      <p class="indicateur__valeur">{tdb.global.personnesEnRetard}</p>
      <p class="indicateur__libelle">personnes ont au moins un module en retard (plus de {d.config.evaluation.delaiRetardJours} jours)</p>
    </li>
  </ul>

  <h2>Progression par profil</h2>
  <GraphiqueBarres
    id="completion"
    titre="Taux de complétion des parcours par profil"
    enteteCategorie="Profil"
    categories={libelles}
    series={[{ nom: 'Modules terminés', valeurs: tdb.parProfil.map((p) => p.tauxCompletion) }]}
  />
  <GraphiqueBarres
    id="scores"
    titre="Score moyen avant et après les modules, par profil"
    enteteCategorie="Profil"
    categories={libelles}
    series={[
      { nom: 'Pré-test', valeurs: tdb.parProfil.map((p) => p.scorePreMoyen) },
      { nom: 'Post-test', valeurs: tdb.parProfil.map((p) => p.scorePostMoyen) },
    ]}
  />

  <div class="tableau-defilant" tabindex="0" role="region" aria-labelledby="legende-profils">
    <table>
      <caption id="legende-profils">Synthèse par profil</caption>
      <thead>
        <tr>
          <th scope="col">Profil</th>
          <th scope="col" class="nombre">Effectif</th>
          <th scope="col" class="nombre">Modules terminés</th>
          <th scope="col" class="nombre">Complétion</th>
          <th scope="col" class="nombre">Réussite au post-test</th>
          <th scope="col" class="nombre">Personnes en retard</th>
        </tr>
      </thead>
      <tbody>
        {tdb.parProfil.map((p, i) => (
          <tr>
            <th scope="row"><a href={`/profils/${p.profil}/`}>{libelles[i]}</a></th>
            <td class="nombre">{p.effectif}</td>
            <td class="nombre">{p.modulesTermines} / {p.modulesAssignes}</td>
            <td class="nombre">{p.tauxCompletion} %</td>
            <td class="nombre">{p.tauxReussite} %</td>
            <td class="nombre">{p.personnesEnRetard}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>Simulations d'hameçonnage</h2>
  <p class="lecture">Mises en situation dans la plateforme (aucun e-mail réel). Objectif : faire baisser le taux de clic et progresser le taux de signalement.</p>
  {tdb.simulations.length > 0 ? (
    <GraphiqueBarres
      id="simulations"
      titre="Taux de clic et taux de signalement par campagne de simulation"
      enteteCategorie="Campagne"
      categories={tdb.simulations.map((s) => `${numero(s.id)} (${formaterDate(s.date, { day: 'numeric', month: 'short' })})`)}
      series={[
        { nom: 'Taux de clic', valeurs: tdb.simulations.map((s) => s.tauxClic) },
        { nom: 'Taux de signalement', valeurs: tdb.simulations.map((s) => s.tauxSignalement) },
      ]}
    />
  ) : (
    <p>Aucune simulation n'a encore eu lieu à la date de référence.</p>
  )}

  <h2>Modules en retard</h2>
  {tdb.retards.length > 0 ? (
    <div class="tableau-defilant" tabindex="0" role="region" aria-labelledby="legende-retards">
      <table>
        <caption id="legende-retards">Modules non terminés au-delà de {d.config.evaluation.delaiRetardJours} jours, par profil (les plus nombreux d'abord)</caption>
        <thead>
          <tr><th scope="col">Module</th><th scope="col">Profil</th><th scope="col" class="nombre">Personnes en retard</th></tr>
        </thead>
        <tbody>
          {tdb.retards.slice(0, 12).map((r) => (
            <tr>
              <th scope="row"><a href={`/modules/${r.module}/`}>{d.libelleModule(r.module)}</a></th>
              <td>{d.libelleProfil(r.profil)}</td>
              <td class="nombre">{r.personnes}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  ) : (
    <p>Aucun module en retard.</p>
  )}

  <h2>Prochaines campagnes</h2>
  <ul class="lecture">
    {tdb.prochainesActions.map((a) => (
      <li>
        <time datetime={a.date}>{formaterDate(a.date)}</time> – <strong>{LIBELLES_TYPE[a.type]}</strong> : {a.titre}
      </li>
    ))}
  </ul>
  <p><a href="/calendrier/">Voir le calendrier complet</a></p>
</Base>
