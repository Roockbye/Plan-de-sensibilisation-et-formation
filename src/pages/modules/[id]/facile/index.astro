---
import Vue from '../../../../vues/Module.astro';
import { languesPubliees } from '../../../../lib/donnees.ts';
import { plateforme } from '../../../../lib/contenus.ts';

export function getStaticPaths() {
  return plateforme().modules.map((m) => m.meta.id).map((id) => ({ params: { id } }));
}
---
<Vue langue={languesPubliees().defaut} id={Astro.params.id!} falc={true} />
