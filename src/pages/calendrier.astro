---
import Base from '../layouts/Base.astro';
import { donnees, formaterDate, FREQUENCE_LIBELLE } from '../lib/donnees.ts';
import { LIBELLES_TYPE, type Action } from '../lib/calendrier.ts';
import { traducteur } from '../i18n/index.ts';

const d = donnees();
const T = traducteur(d.langue);
const c = d.config.campagnes;

const parMois = new Map<string, Action[]>();
for (const a of d.calendrier) {
  const mois = a.date.slice(0, 7);
  parMois.set(mois, [...(parMois.get(mois) ?? []), a]);
}
const libelleMois = (m: string) => {
  const s = formaterDate(`${m}-01`, { month: 'long', year: 'numeric' });
  return s.charAt(0).toUpperCase() + s.slice(1);
};

const frequences = [
  { action: "Parcours d'accueil des nouveaux arrivants", frequence: `À chaque arrivée, sous ${c.onboardingDelaiJours} jours` },
  { action: "Simulation d'hameçonnage pédagogique", frequence: FREQUENCE_LIBELLE[c.simulationPhishing] },
  { action: 'Campagne de rappel et post-tests de consolidation', frequence: FREQUENCE_LIBELLE[c.rappelModules] },
  { action: 'Revue des contenus face aux nouvelles menaces', frequence: FREQUENCE_LIBELLE[c.veilleNouvellesMenaces] },
  { action: 'Exercice de gestion de crise', frequence: FREQUENCE_LIBELLE[c.exerciceCrise] },
  { action: 'Bilan, post-test annuel et révision du plan', frequence: FREQUENCE_LIBELLE.annuelle },
];
---
<Base titre={T('nav.calendrier')} filAriane={[{ libelle: T('nav.calendrier') }]}>
  <h1>Calendrier annuel des actions</h1>
  <div class="lecture">
    <p>
      Ce calendrier est généré automatiquement à partir des fréquences définies dans la configuration de
      {d.config.organisation.nom} et des risques prioritaires : les modules les plus prioritaires sont rappelés en premier.
    </p>
    <p><a class="bouton" href="/calendrier.ics" download>Télécharger le calendrier (format iCalendar .ics)</a></p>
  </div>

  <h2>Fréquences de renouvellement préconisées</h2>
  <div class="tableau-defilant" tabindex="0" role="region" aria-labelledby="legende-frequences">
    <table>
      <caption id="legende-frequences">Fréquence de chaque type d'action</caption>
      <thead><tr><th scope="col">Action</th><th scope="col">Fréquence</th></tr></thead>
      <tbody>
        {frequences.map((f) => <tr><th scope="row">{f.action}</th><td>{f.frequence}</td></tr>)}
      </tbody>
    </table>
  </div>

  <div class="tableau-defilant" tabindex="0" role="region" aria-labelledby="legende-renouvellement">
    <table>
      <caption id="legende-renouvellement">Renouvellement préconisé par module</caption>
      <thead><tr><th scope="col">Module</th><th scope="col">Renouvellement</th><th scope="col">Justification</th></tr></thead>
      <tbody>
        {d.modules.map(({ meta }) => (
          <tr>
            <th scope="row"><a href={`/modules/${meta.id}/`}>{meta.code} – {d.tr(meta.titre)}</a></th>
            <td>{FREQUENCE_LIBELLE[meta.renouvellement]}</td>
            <td>{meta.risques.some((r) => d.risque(r)?.emergent) ? 'Menace émergente, évolution rapide des techniques' : 'Rappel annuel des fondamentaux'}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>Programme de l'année</h2>
  {[...parMois].map(([mois, actions]) => (
    <section aria-labelledby={`mois-${mois}`}>
      <h3 id={`mois-${mois}`}>{libelleMois(mois)}</h3>
      <ul class="calendrier">
        {actions.map((a) => (
          <li class="carte calendrier__action">
            <p class="calendrier__entete">
              <time datetime={a.date}>{formaterDate(a.date, { weekday: 'long', day: 'numeric', month: 'long' })}</time>
              <span class="etiquette">{LIBELLES_TYPE[a.type]}</span>
            </p>
            <h4>{a.titre}</h4>
            <p>{a.description}</p>
            <p>
              {T('commun.profils')} : {a.profils.length ? a.profils.map((p) => d.libelleProfil(p)).join(', ') : 'tous'}.
              {a.modules.length > 0 && <> {T('commun.modules')} : {a.modules.map((m, i) => <>{i > 0 && ', '}<a href={`/modules/${m}/`}>{d.module(m).meta.code}</a></>)}.</>}
            </p>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Base>
